{
  "name": "app-financeiro",
  "version": "0.0.1",
  "private": true,
  "description": "App de controle financeiro pessoal (mobile + Supabase). Ver docs/briefing.md.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "mobile": "pnpm --filter mobile",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "supabase": "pnpm --filter supabase",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^2.98.2",
    "typescript": "^5.6.3"
  }
}
