# Variáveis públicas (vão no bundle, NUNCA coloque secrets aqui).
# Copie para .env.local e preencha com os valores do seu projeto Supabase.

# Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Settings > API > anon public  (chave pública, segura para o cliente)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...

# (futuro) Google OAuth Client IDs
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=...
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=...
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=...
